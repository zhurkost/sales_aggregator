{
  "manifest_version": 3,
  "name": "Автопост • помощник заполнения (beta)",
  "description": "Автопост: заполнение объявлений о продаже и аренде квартир на Kufar, Onliner, Realt и Domovita. Публикацию подтверждает пользователь.",
  "version": "0.9.21",
  "minimum_chrome_version": "112",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://autopost-belarus-mvp.sunlit-lemur-2753.chatgpt.site/*",
        "https://87.199.205.227/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "core.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.kufar.by/*",
        "https://r.onliner.by/*",
        "https://realt.by/*",
        "https://domovita.by/*"
      ],
      "js": [
        "core.js",
        "rental-autocomplete.js",
        "rental-form.js",
        "rental-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Автопост beta: запуск со страницы объявления"
  }
}
