{
  "manifest_version": 3,
  "name": "Автопост • помощник заполнения (beta)",
  "description": "Автопост: категории, формы, фотографии, очередь и ссылки в личном кабинете. Ваша авторизация остаётся в браузере.",
  "version": "0.8.3",
  "minimum_chrome_version": "112",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.kufar.by/*",
    "https://baraholka.onliner.by/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://autopost-belarus-mvp.sunlit-lemur-2753.chatgpt.site/*",
        "https://87.199.205.227/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "core.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://av.by/*",
        "https://cars.av.by/*",
        "https://www.kufar.by/*",
        "https://auto.kufar.by/*",
        "https://kufar.by/*",
        "https://bamper.by/*",
        "https://www.bamper.by/*",
        "https://ab.onliner.by/*",
        "https://baraholka.onliner.by/*",
        "https://profile.onliner.by/*",
        "https://abw.by/*",
        "https://www.abw.by/*",
        "https://flagma.by/*",
        "https://auto.drom.ru/*"
      ],
      "js": [
        "core.js",
        "publication.js",
        "autopublish.js",
        "dom.js",
        "navigation.js",
        "status.js",
        "status-page.js",
        "marketplace.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Автопост beta: запуск со страницы объявления"
  }
}
