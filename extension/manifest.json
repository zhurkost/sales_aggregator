{
  "manifest_version": 3,
  "name": "Автопост • помощник заполнения (beta)",
  "description": "Автомобили: av.by и Kufar; запчасти: Kufar. Вход, выбор категории, капча, проверка и публикация — вручную.",
  "version": "0.2.0",
  "minimum_chrome_version": "112",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://autopost-belarus-mvp.sunlit-lemur-2753.chatgpt.site/*",
        "https://87.199.205.227/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["core.js", "bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://av.by/*", "https://cars.av.by/*", "https://www.kufar.by/*", "https://auto.kufar.by/*"],
      "js": ["core.js", "marketplace.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Автопост beta: запуск со страницы объявления" }
}
