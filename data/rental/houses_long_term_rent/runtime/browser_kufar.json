{
  "startUrl": "https://www.kufar.by/ain/create",
  "setup": [
    {
      "action": "click",
      "selector": "[data-testid=\"ain-show-all-categories\"]",
      "text": "Изменить категорию",
      "matchText": false
    },
    {
      "action": "click",
      "selector": "[data-testid=\"kufar-chose-category-popup\"] li",
      "text": "Недвижимость"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"sub-category-1020\"]",
      "text": "Дома, дачи, коттеджи",
      "matchText": false
    },
    {
      "action": "click",
      "selector": "[data-name=\"type\"] [role=\"button\"]",
      "text": "Долгосрочная аренда"
    }
  ],
  "controls": [
    {
      "field": "kufar.subject",
      "action": "text",
      "selector": "input[name=\"subject\"]"
    },
    {
      "field": "kufar.size",
      "action": "text",
      "selector": "input[name=\"size\"]"
    },
    {
      "field": "kufar.price",
      "action": "text",
      "selector": "input[name=\"price\"]",
      "after": "kufar.currency"
    },
    {
      "field": "kufar.name",
      "action": "text",
      "selector": "input[name=\"name\"]"
    },
    {
      "field": "kufar.phone",
      "action": "text",
      "selector": "input[name=\"phone_0\"]"
    },
    {
      "field": "kufar.body",
      "action": "text",
      "selector": "textarea[name=\"body\"]"
    },
    {
      "field": "kufar.address",
      "action": "autocomplete",
      "selector": "input#geocoder",
      "addressPart": "label",
      "autocomplete": {
        "kind": "address",
        "scopeSelector": "body",
        "optionSelector": "[data-name^=\"autocomplete-option-\"]",
        "confirm": "value-and-closed",
        "selection": "type-then-first",
        "resetSameQuery": true
      }
    },
    {
      "field": "kufar.condition",
      "action": "choices",
      "selector": "[data-name=\"condition\"]"
    },
    {
      "field": "kufar.images",
      "action": "files",
      "selector": "#imageLoaderDropzone",
      "uploadedCountSelector": "[data-name=\"images\"] [class*=\"_counter\"]"
    },
    {
      "field": "kufar.currency",
      "action": "dropdown",
      "selector": "[data-name=\"price\"] [data-testid=\"base-dropdown-ui\"]",
      "optionsSelector": "[data-name=\"price\"] [data-testid=\"dropdown-popup-ui\"] > div",
      "displaySelector": "[class*=\"_value\"]",
      "uiLabels": {
        "BYR": "руб.",
        "USD": "$",
        "EUR": "€"
      }
    },
    {
      "field": "kufar.phone_hidden",
      "action": "choices",
      "selector": "input[name=\"phone_hidden\"]"
    },
    {
      "field": "kufar.contact_person",
      "action": "text",
      "selector": "input[name=\"contact_person\"]"
    },
    {
      "field": "kufar.content_video",
      "action": "text",
      "selector": "input[name=\"content_video\"]"
    },
    {
      "field": "kufar.re_contract",
      "action": "text",
      "selector": "input[name=\"re_contract\"]"
    },
    {
      "field": "kufar.re_heating",
      "action": "choices",
      "selector": "[data-name=\"re_heating\"]"
    },
    {
      "field": "kufar.re_water",
      "action": "choices",
      "selector": "[data-name=\"re_water\"]"
    },
    {
      "field": "kufar.re_sewage",
      "action": "choices",
      "selector": "[data-name=\"re_sewage\"]"
    },
    {
      "field": "kufar.house_rent_near_area",
      "action": "dropdown",
      "selector": "[data-name=\"house_rent_near_area\"]",
      "triggerSelector": "[data-testid=\"base-dropdown-ui\"]",
      "optionsSelector": "[data-name=\"house_rent_near_area\"] [data-testid=\"dropdown-popup-ui\"] > div, [data-testid=\"modal-container\"]:has([data-name=\"house_rent_near_area.hint\"]) [data-testid=\"popup-body\"] > div",
      "displaySelector": "[class*=\"_value\"]"
    },
    {
      "field": "kufar.gaz",
      "action": "check",
      "selector": "[data-name=\"gaz\"] input[type=\"checkbox\"]",
      "checkedValue": "1"
    },
    {
      "field": "kufar.house_type_for_rent",
      "action": "dropdown",
      "selector": "[data-name=\"house_type_for_rent\"]",
      "triggerSelector": "[data-testid=\"base-dropdown-ui\"]",
      "optionsSelector": "[data-name=\"house_type_for_rent\"] [data-testid=\"dropdown-popup-ui\"] > div, [data-testid=\"modal-container\"]:has([data-name=\"house_type_for_rent.hint\"]) [data-testid=\"popup-body\"] > div",
      "displaySelector": "[class*=\"_value\"]"
    },
    {
      "field": "kufar.house_rent_rooms",
      "action": "dropdown",
      "selector": "[data-name=\"house_rent_rooms\"]",
      "triggerSelector": "[data-testid=\"base-dropdown-ui\"]",
      "optionsSelector": "[data-name=\"house_rent_rooms\"] [data-testid=\"dropdown-popup-ui\"] > div, [data-testid=\"modal-container\"]:has([data-name=\"house_rent_rooms.hint\"]) [data-testid=\"popup-body\"] > div",
      "displaySelector": "[class*=\"_value\"]"
    },
    {
      "field": "kufar.house_rent_couchettes",
      "action": "dropdown",
      "selector": "[data-name=\"house_rent_couchettes\"]",
      "triggerSelector": "[data-testid=\"base-dropdown-ui\"]",
      "optionsSelector": "[data-name=\"house_rent_couchettes\"] [data-testid=\"dropdown-popup-ui\"] > div, [data-testid=\"modal-container\"]:has([data-name=\"house_rent_couchettes.hint\"]) [data-testid=\"popup-body\"] > div",
      "displaySelector": "[class*=\"_value\"]"
    },
    {
      "field": "kufar.re_hot_water",
      "action": "check",
      "selector": "[data-name=\"re_hot_water\"] input[type=\"checkbox\"]",
      "checkedValue": "1"
    },
    {
      "field": "kufar.house_rent_services",
      "action": "dropdown",
      "selector": "[data-name=\"house_rent_services\"]",
      "triggerSelector": "[data-testid=\"base-dropdown-ui\"]",
      "optionsSelector": "[data-name=\"house_rent_services\"] [data-testid=\"dropdown-popup-ui\"] > div, [data-testid=\"modal-container\"]:has([data-name=\"house_rent_services.hint\"]) [data-testid=\"popup-body\"] > div",
      "displaySelector": "[class*=\"_value\"]"
    },
    {
      "field": "kufar.size_area",
      "action": "text",
      "selector": "input[name=\"size_area\"]"
    },
    {
      "field": "kufar.house_improvements",
      "action": "choices",
      "selector": "[data-name=\"house_improvements\"]"
    },
    {
      "field": "kufar.house_rent_area",
      "action": "choices",
      "selector": "[data-name=\"house_rent_area\"]"
    },
    {
      "field": "kufar.house_rent_for_whom",
      "action": "choices",
      "selector": "[data-name=\"house_rent_for_whom\"]"
    },
    {
      "field": "kufar.distance_ringway",
      "action": "text",
      "selector": "input[name=\"distance_ringway\"]"
    },
    {
      "field": "kufar.negotiable_price",
      "action": "check",
      "selector": "[data-name=\"negotiable_price\"] input[type=\"checkbox\"]"
    }
  ],
  "next": [],
  "submit": [],
  "format": 1,
  "platform": "kufar",
  "observedAt": "2026-11-08",
  "note": "Длительная аренда дома целиком. После заполнения пользователь проверяет форму и сам выполняет переходы и окончательную отправку.",
  "ready": [
    {
      "selector": "[data-testid=\"name_selected_category\"]",
      "text": "Дома"
    },
    {
      "selector": "[data-name=\"type\"] [class*=\"chip__filled-green\"]",
      "text": "Долгосрочная аренда"
    },
    {
      "selector": "[data-testid=\"kufar-chose-category-popup\"]",
      "absent": true
    }
  ],
  "addressBeforeDeal": true,
  "oneChangePerTick": true,
  "addressCategoryText": "Дома"
}
