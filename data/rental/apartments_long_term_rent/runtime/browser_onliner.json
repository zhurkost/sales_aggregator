    },
    {
      "field": "onliner.agency_unp",
      "action": "text",
      "selector": "input[placeholder=\"УНП\"]"
    },
    {
      "field": "onliner.agency_contract_number",
      "action": "text",
      "selector": "input[placeholder=\"Номер договора\"]"
    },
    {
      "field": "onliner.agency_contract_date",
      "action": "text",
      "selector": "input[placeholder=\"Дата заключения договора\"]"
    },
    {
      "field": "onliner.agency_licence_number",
      "action": "text",
      "selector": "input[placeholder=\"Номер лицензии\"]"
    },
    {
      "field": "onliner.agency_licence_date",
      "action": "text",
      "selector": "input[placeholder=\"Дата выдачи лицензии\"]"
    }
