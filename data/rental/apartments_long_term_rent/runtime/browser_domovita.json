{
  "startUrl": "https://domovita.by/new/add",
  "setup": [
    {
      "action": "click",
      "selector": "label",
      "text": "Сдаче длительно"
    },
    {
      "action": "click",
      "selector": "label",
      "text": "Квартиры"
    }
  ],
  "controls": [
    {
      "field": "domovita.contact_name",
      "action": "text",
      "selector": "input[name=\"contact_name\"]"
    },
    {
      "field": "domovita.contact_phone",
      "action": "text",
      "selector": "input[name=\"phones.0.contact_phone\"]"
    },
    {
      "field": "domovita.additional_phone_1",
      "action": "text",
      "selector": "input[name=\"phones.1.contact_phone\"]"
    },
    {
      "field": "domovita.additional_phone_2",
      "action": "text",
      "selector": "input[name=\"phones.2.contact_phone\"]"
    },
    {
      "field": "domovita.email",
      "action": "text",
      "selector": "input[name=\"email\"]"
    },
    {
      "field": "domovita.area_total",
      "action": "text",
      "selector": "input[name=\"area_total\"]"
    },
    {
      "field": "domovita.area_kitchen",
      "action": "text",
      "selector": "input[name=\"area_kitchen\"]"
    },
    {
      "field": "domovita.area_living",
      "action": "text",
      "selector": "input[name=\"area_living\"]"
    },
    {
      "field": "domovita.storeys",
      "action": "text",
      "selector": "input[name=\"storeys\"]"
    },
    {
      "field": "domovita.storey",
      "action": "text",
      "selector": "input[name=\"storey\"]"
    },
    {
      "field": "domovita.monthly_price",
      "action": "text",
      "selector": "input[name=\"price\"]",
      "after": "domovita.currency"
    },
    {
      "field": "domovita.rooms",
      "action": "choices",
      "selector": "input[name=\"rooms\"]"
    },
    {
      "field": "domovita.account_type",
      "action": "choices",
      "selector": "input[name=\"account_type\"]"
    },
    {
      "field": "domovita.amenities",
      "action": "choices",
      "selector": "input[type=\"checkbox\"]"
    },
    {
      "field": "domovita.tenant_conditions",
      "action": "choices",
      "selector": "input[type=\"checkbox\"]"
    },
    {
      "field": "domovita.description",
      "action": "richtext",
      "selector": ".tiptap[contenteditable=\"true\"]",
      "index": 0
    },
    {
      "field": "domovita.images",
      "action": "files",
      "selector": "input[type=\"file\"]",
      "blockedSelector": "[class*=\"image-upload-dropzone-disabled\"]",
      "blockedMessage": "Подтвердите телефон на Domovita. После разблокировки загрузки фотографии перенесутся автоматически."
    },
    {
      "field": "domovita.currency",
      "action": "dropdown",
      "selector": "div:has(> input[name=\"price_currency_text\"])",
      "triggerSelector": ".custom-select__control",
      "displaySelector": ".custom-select__single-value",
      "optionsSelector": "[role=\"option\"]"
    },
    {
      "field": "domovita.town",
      "action": "autocomplete",
      "selector": "div:has(> input[name=\"town_id\"]) input[role=\"combobox\"]",
      "addressPart": "settlement",
      "autocomplete": {
        "kind": "settlement",
        "scopeSelector": "div:has(> .custom-select__control)",
        "optionSelector": "[role=\"option\"]",
        "busySelector": ".custom-select__menu-notice--loading",
        "selectedValueSelector": ".custom-select__single-value",
        "confirm": "display-and-closed",
        "labelFormat": "settlement-region-district",
        "contextParts": [
          "region",
          "district"
        ]
      }
    },
    {
      "field": "domovita.street",
      "action": "autocomplete",
      "selector": "div:has(> input[name=\"street_name\"]) input[role=\"combobox\"]",
      "addressPart": "street",
      "after": "domovita.town",
      "autocomplete": {
        "kind": "street",
        "scopeSelector": "div:has(> .custom-select__control)",
        "optionSelector": "[role=\"option\"]",
        "busySelector": ".custom-select__menu-notice--loading",
        "selectedValueSelector": ".custom-select__single-value",
        "confirm": "display-and-closed"
      }
    },
    {
      "field": "domovita.house_number",
      "action": "autocomplete",
      "selector": "div:has(> input[name=\"house_number\"]) input[role=\"combobox\"]",
      "addressPart": "house",
      "after": "domovita.street",
      "autocomplete": {
        "kind": "house",
        "scopeSelector": "div:has(> .custom-select__control)",
        "optionSelector": "[role=\"option\"]",
        "busySelector": ".custom-select__menu-notice--loading",
        "selectedValueSelector": ".custom-select__single-value",
        "confirm": "display-and-closed"
      }
    }
  ],
  "next": [
    {
      "action": "click",
      "selector": "button",
      "text": "Далее"
    }
  ],
  "submit": [],
  "format": 1,
  "platform": "domovita",
  "observedAt": "2026-11-05",
  "note": "Проверены элементы формы. Переходы после сохранения и окончательная публикация требуют проверки на реальном объявлении; без подтверждения успешной подачи статус published не выставляется.",
  "ready": [
    {
      "selector": "input[name=\"action\"][value=\"rent\"]:checked"
    },
    {
      "selector": "input[name=\"type\"][value=\"flats\"]:checked"
    }
  ]
}
